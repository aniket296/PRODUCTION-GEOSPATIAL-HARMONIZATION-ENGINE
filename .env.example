# ==============================================================================
# SIH26013: Multi-Source Geospatial Data Harmonization Engine
# Production Environment Configuration Template
# ==============================================================================

# Application Environment
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
DEBUG=false
SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-at-least-32-chars
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
MAX_UPLOAD_SIZE_BYTES=104857600  # 100 MB

# PostgreSQL & PostGIS Database Configuration
POSTGRES_USER=cadastre_user
POSTGRES_PASSWORD=cadastre_secure_password
POSTGRES_DB=cadastre_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://cadastre_user:cadastre_secure_password@postgres:5432/cadastre_db
DATABASE_SYNC_URL=postgresql+psycopg2://cadastre_user:cadastre_secure_password@postgres:5432/cadastre_db

# Redis & Celery Worker Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# MinIO S3-Compatible Object Storage Configuration
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_secure_password
MINIO_ENDPOINT=minio:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_SECURE=false
MINIO_BUCKET_RAW=cadastral-raw
MINIO_BUCKET_HARMONIZED=cadastral-harmonized

# Offline-First Basemap Tile Provider Configuration (Local tile service)
LOCAL_TILE_SERVER_URL=http://localhost:8080/tiles/{z}/{x}/{y}.pbf

# Deterministic Cadastral Topology Tolerances (Projected metric units: meters / sqm / ratios)
MAX_OVERLAP_PERCENT_THRESHOLD=2.0       # Overlaps <= 2% are AUTO_RESOLVABLE; > 2% are CRITICAL_DISPUTE
SLIVER_MAX_AREA_SQM=10.0                 # Polygons < 10 m² candidate for sliver
SLIVER_MAX_POLSBY_POPPER=0.05            # Polsby-Popper compactness < 0.05 candidate for sliver (4πA / P²)
BOUNDARY_GAP_TOLERANCE_METERS=0.5        # Boundary gap detection tolerance (meters)
SNAP_HEALING_TOLERANCE_METERS=0.25       # Boundary snapping tolerance for ST_Snap (meters)
GRID_TOLERANCE_METERS=0.001              # ST_SnapToGrid precision tolerance (1 millimeter)
